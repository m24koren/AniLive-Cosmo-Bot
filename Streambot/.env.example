# ============================================================
# Streambot — namunaviy sozlamalar.
# Lokal ishga tushirish: bu faylni `.env` nomi bilan nusxalang.
# Render'da shu o'zgaruvchilar Dashboard -> Environment bo'limiga kiritiladi.
# HECH QACHON haqiqiy token yoki parolni shu faylga yozmang!
# ============================================================

# --- Umumiy ---
APP_ENV=production            # development | production
LOG_LEVEL=INFO
DEFAULT_LANG=uz               # uz | ru | en

# --- Telegram ---
BOT_TOKEN=                    # BotFather'dan. FAQAT Render env'da saqlang!
SUPER_ADMIN_IDS=8869400604    # bosh admin Telegram ID; ko'p bo'lsa vergul bilan: 111,222
WEBHOOK_SECRET=               # Render o'zi yaratadi (lokal uchun tasodifiy 32+ belgi)
BASE_URL=                     # Render'da BO'SH qoldiring (avtomatik olinadi). Lokal webhook: https://xxx.ngrok.app
WEBAPP_URL=                   # bo'sh bo'lsa BASE_URL + /app
BOT_MODE=webhook              # webhook (Render) | polling (lokal)
AUTO_MIGRATE=true             # api ishga tushganda jadvallarni yangilaydi
WORKER_EMBEDDED=true          # true: fon vazifalari API ichida | false: alohida worker
DISABLED_MODULES=             # o'chiriladigan modullar, vergul bilan: recommendations,referral

# --- Xavfsizlik ---
SECRET_KEY=                   # Render o'zi yaratadi (lokal uchun tasodifiy 64 belgi)
ENCRYPTION_KEY=               # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
INIT_DATA_TTL_SECONDS=86400
STREAM_TOKEN_TTL_SECONDS=3600

# --- Baza va kesh ---
DATABASE_URL=postgresql://user:pass@localhost:5432/streambot
REDIS_URL=                    # bo'sh bo'lsa xotiradagi kesh ishlaydi (faqat 1 instance uchun)

# --- Media saqlash ---
STORAGE_BACKEND=telegram      # telegram (file_id) | r2 | s3  (20 MB dan katta videoni Web App'da oqimlash uchun r2/s3 kerak)
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Oqim (stream) va transcoding ---
STREAM_REDIRECT_PRESIGNED=false
TRANSCODER=none               # none | local (ffmpeg kerak) | external
TRANSCODER_URL=
TRANSCODER_TOKEN=

# --- Limitlar ---
RATE_LIMIT_PER_MINUTE=60
DEVICE_LIMIT_DEFAULT=2        # bitta akkauntda bir vaqtda nechta qurilma

# --- Uxlab qolmaslik (Render bepul reja) ---
KEEPALIVE_URL=                # https://<servis>.onrender.com/health
KEEPALIVE_INTERVAL_SECONDS=480

# --- Monitoring chegaralari (Render bepul reja: 512 MB RAM) ---
MEMORY_LIMIT_MB=0             # 0 = konteyner limitini avtomatik aniqlaydi
MEMORY_WARN_PERCENT=85        # adminlarga ogohlantirish
MEMORY_CRIT_PERCENT=90        # kritik: ogohlantirish + avtomatik tozalash
DISK_WARN_PERCENT=85
DISK_CRIT_PERCENT=90
TMP_MAX_AGE_HOURS=6
OUTBOX_KEEP_DAYS=7
